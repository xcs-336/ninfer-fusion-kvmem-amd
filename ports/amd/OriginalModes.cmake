# Original extra registrations from the pinned optimized baseline. Default
# programs live in their family files. Existing semantic registrations are not
# duplicated here. CUDA TMA-only staging is explicitly outside the AMD path.
function(ninfer_register_original_mode name target timeout)
  if(NOT TARGET ${target} OR TEST ${name})
    return()
  endif()
  cmake_parse_arguments(MODE "" "" "ARGS;ENVIRONMENT" ${ARGN})
  if(MODE_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unparsed original test mode: ${name}")
  endif()
  ninfer_add_gpu_test(${name} ${target} ${timeout} ${MODE_ARGS})
  set_tests_properties(${name} PROPERTIES SKIP_RETURN_CODE 77 RUN_SERIAL TRUE)
  if(MODE_ENVIRONMENT)
    set_tests_properties(${name} PROPERTIES ENVIRONMENT "${MODE_ENVIRONMENT}")
  endif()
endfunction()

